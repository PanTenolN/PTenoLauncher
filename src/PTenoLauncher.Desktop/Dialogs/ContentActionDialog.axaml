<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PTenoLauncher.Desktop.Dialogs.ContentActionDialog" Width="660" SizeToContent="Height" MaxHeight="640" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="9">
    <TextBlock Name="ItemTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ScrollViewer MaxHeight="310">
      <SelectableTextBlock Name="ItemSource" TextWrapping="Wrap"/>
    </ScrollViewer>
    <TextBlock Text="{DynamicResource Text.ContentDestination}"/>
    <SelectableTextBlock Name="ItemDestination" TextWrapping="Wrap"/>
    <CheckBox Name="BackupWorld" IsVisible="False" IsChecked="True" Content="{DynamicResource Text.ContentBackupWorld}"/>
    <SelectableTextBlock Name="BackupDestination" IsVisible="False" TextWrapping="Wrap"/>
    <WrapPanel>
      <Button Name="ConfirmAction" Click="Confirm" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource Text.Cancel}" Click="Cancel" IsCancel="True"/>
    </WrapPanel>
  </StackPanel>
</Window>
