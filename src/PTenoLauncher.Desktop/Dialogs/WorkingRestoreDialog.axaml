<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PTenoLauncher.Desktop.Dialogs.WorkingRestoreDialog" Title="{DynamicResource Text.WorkingReview}"
        Width="820" Height="590" MinWidth="530" MinHeight="430" WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
    <TextBlock Name="ProfileSummary" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ScrollViewer Grid.Row="1">
      <SelectableTextBlock Name="RestoreDetails" TextWrapping="Wrap"/>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Name="MissingSection" Spacing="8">
      <ComboBox Name="MissingFiles" HorizontalAlignment="Stretch" SelectionChanged="MissingSelectionChanged">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <WrapPanel>
        <Button Content="{DynamicResource Text.WorkingAddFile}" Click="Supply" Margin="0,0,8,0"/>
        <Button Name="FetchButton" Content="{DynamicResource Text.WorkingFetchExact}" Click="Fetch"/>
      </WrapPanel>
    </StackPanel>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Name="ConfirmRestore" Content="{DynamicResource Text.WorkingApply}" Click="Apply" Margin="0,0,8,0"/>
      <Button Name="CancelRestore" Content="{DynamicResource Text.Cancel}" Click="Cancel" IsCancel="True"/>
    </WrapPanel>
  </Grid>
</Window>
