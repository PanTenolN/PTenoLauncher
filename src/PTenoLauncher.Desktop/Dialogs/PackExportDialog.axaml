<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PTenoLauncher.Desktop.Dialogs.PackExportDialog" Title="{DynamicResource Text.ExportPack}"
        Width="760" Height="650" MinWidth="520" MinHeight="470" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <StackPanel Spacing="8">
      <TextBlock Name="ExportProfile" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Name="ExportTarget" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Text.ExportPolicy}" Classes="secondary" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource Text.ExportNameLabel}"/>
      <TextBox Name="ExportName" MaxLength="80"/>
      <CheckBox Name="ExportGraphics"><TextBlock Text="{DynamicResource Text.ExportGraphicsChoice}" TextWrapping="Wrap"/></CheckBox>
    </StackPanel>
    <ListBox Grid.Row="1" Name="ExportFiles">
      <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="5" Spacing="4">
          <TextBlock Text="{Binding File}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Decision}" TextWrapping="Wrap"/>
          <SelectableTextBlock Text="{Binding Link}" IsVisible="{Binding HasLink}" Classes="secondary" TextWrapping="Wrap"/>
        </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Name="ExportStatus" TextWrapping="Wrap" Classes="secondary"/>
      <WrapPanel>
        <Button Name="PreviewExport" Content="{DynamicResource Text.PackPreview}" Click="Preview" Margin="0,0,8,4"/>
        <Button Name="ConfirmExport" Content="{DynamicResource Text.ExportSave}" Click="Save" Classes="primary" IsEnabled="False" Margin="0,0,8,4"/>
        <Button Content="{DynamicResource Text.Cancel}" Click="Cancel" IsCancel="True" Margin="0,0,0,4"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
