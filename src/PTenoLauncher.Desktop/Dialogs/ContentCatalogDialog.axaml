<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PTenoLauncher.Desktop.Dialogs.ContentCatalogDialog" Width="750" Height="560" MinWidth="540" MinHeight="380" WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <StackPanel Name="ContentSearchStep" Spacing="6">
      <TextBlock Name="ContentTarget" TextWrapping="Wrap"/>
      <ComboBox Name="ContentSource" SelectedIndex="0" SelectionChanged="SelectSource" IsEnabled="{Binding IsIdle}">
        <ComboBoxItem Content="Modrinth"/>
        <ComboBoxItem Content="CurseForge"/>
      </ComboBox>
      <TextBlock Name="ContentSourceUnavailable" Text="{DynamicResource Text.ContentCurseForgeUnavailable}" IsVisible="False" TextWrapping="Wrap"/>
      <Grid Name="ContentSearchBar" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding IsIdle}">
        <TextBox Name="ContentQuery" KeyDown="SearchKey" TextChanged="QueryChanged" MaxLength="200"/>
        <Button Grid.Column="1" Name="ContentSearch" Content="{DynamicResource Text.Search}" Click="Search"/>
      </Grid>
    </StackPanel>
    <Grid Name="ContentCatalogStep" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" IsEnabled="{Binding IsIdle}">
      <ListBox Name="ContentResults" SelectionChanged="SelectResult" DoubleTapped="QueueResult">
        <ListBox.ItemTemplate><DataTemplate>
          <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
            <Panel Width="28" Height="28"><PathIcon Data="M2,4 L8,1 L14,4 L14,12 L8,15 L2,12 Z M2,4 L8,7 L14,4 M8,7 L8,15" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image AttachedToVisualTree="IconAttached" DataContextChanged="IconChanged"/></Panel>
            <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1"><StackPanel Spacing="9">
        <Panel Name="ContentIconPanel" IsVisible="False" Width="64" Height="64" HorizontalAlignment="Left">
          <PathIcon Data="M2,4 L8,1 L14,4 L14,12 L8,15 L2,12 Z M2,4 L8,7 L14,4 M8,7 L8,15" Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Name="ContentIcon" DataContextChanged="IconChanged"/>
        </Panel>
        <TextBlock Name="ContentTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Name="ContentDescription" TextWrapping="Wrap"/>
        <Button Name="ContentProjectPage" Content="{DynamicResource Text.ContentProjectPage}" Click="OpenProject" IsVisible="False"/>
        <TextBlock Name="ContentVersionStatus" TextWrapping="Wrap"/>
        <ComboBox Name="ContentVersions" HorizontalAlignment="Stretch" SelectionChanged="SelectVersion"/>
        <TextBlock Name="ContentFile" TextWrapping="Wrap"/>
        <TextBlock Name="ContentRequirements" TextWrapping="Wrap"/>
        <WrapPanel>
          <Button Name="ContentAdd" Content="{DynamicResource Text.CatalogAdd}" Click="Add" IsEnabled="False" Classes="primary" Margin="0,0,8,0"/>
          <Button Name="ContentRemove" Content="{DynamicResource Text.CartRemove}" Click="RemoveSelected" IsVisible="False"/>
        </WrapPanel>
      </StackPanel></ScrollViewer>
    </Grid>
    <Grid Name="ContentCartStep" Grid.RowSpan="2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource Text.Cart}" FontWeight="SemiBold"/>
        <TextBlock Name="ContentCartTarget" TextWrapping="Wrap"/>
      </StackPanel>
      <ListBox Grid.Row="1" Name="ContentCartRows" IsEnabled="{Binding IsIdle}">
        <ListBox.ItemTemplate><DataTemplate>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding VersionLabel}" TextWrapping="Wrap"/>
              <SelectableTextBlock Text="{Binding FileName}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Result}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Text.CartRemove}" Click="RemoveCartPick" IsVisible="{Binding !Installed}"/>
          </Grid>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <StackPanel><TextBlock Name="ContentSearchStatus" TextWrapping="Wrap"/><TextBlock Name="ContentInstallStatus" TextWrapping="Wrap" Classes="secondary"/></StackPanel>
      <Button Name="ContentBack" Grid.Column="1" Content="{DynamicResource Text.CartBackToSearch}" Click="Back" IsVisible="False" IsEnabled="{Binding IsIdle}"/>
      <Panel Grid.Column="2" IsEnabled="{Binding IsIdle}">
        <Button Name="ContentDone" Click="Review" IsEnabled="False" Classes="primary"/>
        <Button Name="ContentInstall" Content="{DynamicResource Text.ContentCartInstall}" Click="Install" IsVisible="False" Classes="primary"/>
      </Panel>
      <Button Grid.Column="3" Content="{DynamicResource Text.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancelOperation}"/>
      <Button Grid.Column="4" Content="{DynamicResource Text.Close}" Click="CloseWindow" IsEnabled="{Binding IsIdle}"/>
    </Grid>
  </Grid>
</Window>
